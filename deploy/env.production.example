# 复制为服务器上的 .env 后填写（不要提交到 git）
# cp deploy/env.production.example .env

# PostgreSQL（仅 Docker 内网访问）
POSTGRES_USER=leadspace
POSTGRES_PASSWORD=change-me-use-openssl-rand
POSTGRES_DB=leadspace

# NextAuth / Auth.js v5
AUTH_SECRET=change-me-use-openssl-rand-base64-32
AUTH_URL=https://ali.orblead.com

# 运维紧急告警
# - 优先：企微自建应用推个人（LEADspace 运维）
# WECOM_CORP_ID=
# WECOM_AGENT_ID=1000037
# WECOM_AGENT_SECRET=
# WECOM_OPS_USERID=
# - 可选回退：群 Webhook（站点宕机 bash 脚本也会读）
# OPS_ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 小绿盒企微外推（关单回告 / 撤机待确认 / 导入成功 → 业务群；运维内存告警走上面 WECOM_*）
# XLV_OUTBOUND_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# XLV_OPS_CRON_SECRET=用 openssl rand -hex 16 生成，供 cron 调 /api/xlv/ops/health
# XLV_OPS_MEM_WARN_MB=1200

# N7 外推（MVP-A：关单成功 → 企微群机器人 Webhook；不配则跳过）
# 群设置 → 群机器人 → Webhook 地址
# N7_OUTBOUND_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 可选：外推链接域名（默认 AUTH_URL）
# N7_PUBLIC_BASE_URL=https://ali.orblead.com
